hashes": {"md5": "0e77f628aa613bbe3145c6a24f8973f3","sha1": "5624ede8b8e374979194acaae9f34cff23b62b3e","sha256": "173904bdbd783ba0fac92c5bcc05da5d09f0ce7eed24346666ea0a239461f9b4"},"properties": {"license": "Apache License version 2.0: https:\/\/www.apache.org\/licenses\/LICENSE-2.0","id59": "pkg:maven\/org.xmlresolver\/xmlresolver@5.2.2"}},{"description": {"text": "An XML entity\/uri resolver"},"location": {"uri": "file://C:\\Users\\kurindinvv\\.gradle\\caches\\modules-2\\files-2.1\\org.xmlresolver\\xmlresolver\\5.2.2\\152378e04ba01898847bf38fad5023c7d52f0c9d\\xmlresolver-5.2.2.jar"},"hashes": {"md5": "0de20e8f7acfa5942d78c239d3034deb","sha1": "152378e04ba01898847bf38fad5023c7d52f0c9d","sha256": "efc92bd7ed32b3e57095e0b3e872051ccfbbdcc980831ef33e89e38161a85222"},"properties": {"license": "Apache License version 2.0: https:\/\/www.apache.org\/licenses\/LICENSE-2.0","id60": "pkg:maven\/org.xmlresolver\/xmlresolver@5.2.2"}},{"description": {"text": "An XML entity\/uri resolver"},"location": {"uri": "file://C:\\Users\\kurindinvv\\.gradle\\caches\\modules-2\\files-2.1\\org.xmlresolver\\xmlresolver\\5.3.3\\e0c9cb7fcad389a50c1fbe3237af8857eca9c2b3\\xmlresolver-5.3.3-data.jar"},"hashes": {"md5": "59c51b08ba448bc9473d92e68bf84873","sha1": "e0c9cb7fcad389a50c1fbe3237af8857eca9c2b3","sha256": "b0c487ad2f3e558be8d829c916d2458d10aca6a5bafa7a4d0524b70845e48a5c"},"properties": {"license": "Apache License version 2.0: https:\/\/www.apache.org\/licenses\/LICENSE-2.0","id61": "pkg:maven\/org.xmlresolver\/xmlresolver@5.3.3"}},{"description": {"text": "An XML entity\/uri resolver"},"location": {"uri": "file://C:\\Users\\kurindinvv\\.gradle\\caches\\modules-2\\files-2.1\\org.xmlresolver\\xmlresolver\\5.3.3\\1b838b0d69eef8d46c813d88a604e3cb4c6035fe\\xmlresolver-5.3.3.jar"},"hashes": {"md5": "e883f28e14ce902f66941bd8bc25233a","sha1": "1b838b0d69eef8d46c813d88a604e3cb4c6035fe","sha256": "1fe4d5b92f708dcdb82dbce12919e0171e6b5ca62c6dca6220483625098feb5f"},"properties": {"license": "Apache License version 2.0: https:\/\/www.apache.org\/licenses\/LICENSE-2.0","id62": "pkg:maven\/org.xmlresolver\/xmlresolver@5.3.3"}}],"results": [ {"ruleId": "CVE-2025-48734","level": "warning","message": {"text": "CVE-2025-48734 - Improper Access Control vulnerability in Apache Commons.\n\n\n\nA special BeanIntrospector class was added in version 1.9.2. This can be used to stop attackers from using the declared class property of Java enum objects to get access to the classloader. However this protection was not enabled by default. PropertyUtilsBean (and consequently BeanUtilsBean) now disallows declared class level property access by default.\n\n\n\n\n\nReleases 1.11.0 and 2.0.0-M2 address a potential security issue when accessing enum properties in an uncontrolled way. If an application using Commons BeanUtils passes property paths from an external source directly to the getProperty() method of PropertyUtilsBean, an attacker can access the enum\u2019s class loader via the \u201CdeclaredClass\u201D property available on all Java \u201Cenum\u201D objects. Accessing the enum\u2019s \u201CdeclaredClass\u201D allows remote attackers to access the ClassLoader and execute arbitrary code. The same issue exists with PropertyUtilsBean.getNestedProperty().\nStarting in versions 1.11.0 and 2.0.0-M2 a special BeanIntrospector suppresses the \u201CdeclaredClass\u201D property. Note that this new BeanIntrospector is enabled by default, but you can disable it to regain the old behavior; see section 2.5 of the user's guide and the unit tests.\n\nThis issue affects Apache Commons BeanUtils 1.x before 1.11.0, and 2.x before 2.0.0-M2.Users of the artifact commons-beanutils:commons-beanutils\n\n 1.x are recommended to upgrade to version 1.11.0, which fixes the issue.\n\n\nUsers of the artifact org.apache.commons:commons-beanutils2\n\n 2.x are recommended to upgrade to version 2.0.0-M2, which fixes the issue."},"partialFingerprints": {"vulnerabilityHash": "eb5f8cf1401189092840e52c25d48e77"},"locations": [{"physicalLocation": {"artifactLocation": {"uri": "file://C:\\Users\\kurindinvv\\.gradle\\caches\\modules-2\\files-2.1\\commons-beanutils\\commons-beanutils\\1.9.4\\d52b9abcd97f38c81342bb7e7ae1eee9b73cba51\\commons-beanutils-1.9.4.jar","index": 11 }},"logicalLocations": [{"fullyQualifiedName": "pkg:maven\/commons-beanutils\/commons-beanutils@1.9.4"}]}]}, {"ruleId": "CVE-2025-48924","level": "warning","message": {"text": "CVE-2025-48924 - Uncontrolled Recursion vulnerability in Apache Commons Lang.\n\nThis issue affects Apache Commons Lang: Starting with\u00A0commons-lang:commons-lang\u00A02.0 to 2.6, and, from org.apache.commons:commons-lang3 3.0 before\u00A03.18.0.\n\nThe methods ClassUtils.getClass(...) can throw\u00A0StackOverflowError on very long inputs. Because an Error is usually not handled by applications and libraries, a \nStackOverflowError could\u00A0cause an application to stop.\n\nUsers are recommended to upgrade to version 3.18.0, which fixes the issue."},"partialFingerprints": {"vulnerabilityHash": "065ac7df188e8c80a7c2979bc5e08183"},"locations": [{"physicalLocation": {"artifactLocation": {"uri": "file://C:\\Users\\kurindinvv\\.gradle\\caches\\modules-2\\files-2.1\\org.apache.commons\\commons-lang3\\3.8.1\\6505a72a097d9270f7a9e7bf42c4238283247755\\commons-lang3-3.8.1.jar","index": 15 }},"logicalLocations": [{"fullyQualifiedName": "pkg:maven\/org.apache.commons\/commons-lang3@3.8.1"}]}]}]}]}